        <button class="nav-item" data-tab="tab-schedule" onclick="switchTab('tab-schedule', this)">
            <span class="icon">📅</span><span>График</span>
        </button>
        <button class="nav-item" data-tab="tab-homework" onclick="switchTab('tab-homework', this)">
            <span class="icon">➕</span><span>Добавить</span>
        </button>
        <button class="nav-item" data-tab="tab-tasks" onclick="switchTab('tab-tasks', this)">
            <span class="icon">📝</span><span>Задачи</span>
