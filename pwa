            <span class="icon">🕒</span><span>История</span>
        </button>
    </nav>

    <!-- Модалка Настроек -->
    <div id="settings-modal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-handle"></div>
            <div class="modal-header">
                <h3>Настройки EduPlan</h3>
                <button class="btn-close" onclick="closeSettings()">&times;</button>
            </div>
            <div class="form-group">
                <label>Тема оформления:</label>
                <select id="setting-theme" onchange="changeTheme(this.value)">
                    <option value="dark">Тёмная (Dark)</option><option value="light">Светлая (Light)</option>
                    <option value="purple">Неон (Purple)</option><option value="blue">Океан (Blue)</option>
                    <option value="emerald">Изумруд (Emerald)</option><option value="sunset">Закат (Sunset)</option>
                </select>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Работа (мин):</label><input id="setting-work" type="number" min="5" max="120" step="5" value="25" onchange="saveSettings()"></div>
                <div class="form-group"><label>Отдых (мин):</label><input id="setting-rest" type="number" min="1" max="30" step="1" value="5" onchange="saveSettings()"></div>
            </div>
