    <!-- Полноэкранный таймер iOS -->
    <div id="timer-overlay" class="timer-overlay">
        <div class="timer-panel">
            <button class="timer-btn-close" onclick="closeTimer()">&times;</button>
            <h2 id="timer-subject">Алгебра</h2>
            <p id="timer-desc">Параграф 12</p>

            <div class="timer-circle" id="timer-circle-elem">
                <div class="timer-circle-inner">
                    <div id="timer-display" class="timer-time">25:00</div>
                    <div id="timer-phase" class="timer-phase">ФОКУС</div>
                </div>
            </div>

            <div class="timer-controls">
                <button class="btn-secondary" id="btn-timer-pause" style="min-height:50px; font-weight:700;" onclick="toggleTimer()">⏸ Пауза</button>
                <button class="btn-danger" style="min-height:50px; font-weight:700;" onclick="finishTask(true)">⏹ Готово</button>
            </div>
        </div>
    </div>

    <script>
        let schedule = JSON.parse(localStorage.getItem('eduplan_schedule')) || {};
        let tasks = JSON.parse(localStorage.getItem('eduplan_tasks')) || [];
        let history = JSON.parse(localStorage.getItem('eduplan_history')) || [];
        let currentTheme = localStorage.getItem('eduplan_theme') || 'dark';
        let workTimerMinutes = parseInt(localStorage.getItem('eduplan_work_time')) || 25;
        let restTimerMinutes = parseInt(localStorage.getItem('eduplan_rest_time')) || 5;

        let selectedDayPill = 1;
        let currentTimerTask = null;
        let timerInterval = null;
        let timeRemaining = 0;
        let timerTargetTimestamp = 0;
        let isPaused = false;
        let isRestPhase = false;

        document.body.setAttribute('data-theme', currentTheme);
        document.getElementById('setting-theme').value = currentTheme;
        document.getElementById('setting-work').value = workTimerMinutes;
        document.getElementById('setting-rest').value = restTimerMinutes;

        function playAlertSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                osc.frequency.setValueAtTime(880, ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.4);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.4);
            } catch (e) {}
            if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
        }

        document.addEventListener('visibilitychange', () => {
            if (!document.hidden && currentTimerTask && !isPaused) syncTimerWithTarget();
        });
        window.addEventListener('pageshow', () => {
            if (currentTimerTask && !isPaused) syncTimerWithTarget();
        });

        function syncTimerWithTarget() {
            const now = Date.now();
            const diff = Math.round((timerTargetTimestamp - now) / 1000);
            timeRemaining = Math.max(0, diff);
            updateTimerDisplay();
            if (timeRemaining <= 0) handleTimerCompletion();
        }

        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            const target = document.getElementById(tabId);
            if (target) target.classList.add('active');
            if (btn) btn.classList.add('active');
            window.scrollTo(0, 0);

            if (tabId === 'tab-dashboard') renderDashboard();
            if (tabId === 'tab-tasks') renderTasks();
            if (tabId === 'tab-history') renderHistory();
            if (tabId === 'tab-schedule') loadScheduleForDay();
        }

        function openSettings() { document.getElementById('settings-modal').style.display = 'flex'; }
        function closeSettings() { document.getElementById('settings-modal').style.display = 'none'; }
        function changeTheme(theme) { currentTheme = theme; document.body.setAttribute('data-theme', theme); localStorage.setItem('eduplan_theme', theme); }
        function saveSettings() {
            workTimerMinutes = Math.max(5, Math.min(120, parseInt(document.getElementById('setting-work').value) || 25));
            restTimerMinutes = Math.max(1, Math.min(30, parseInt(document.getElementById('setting-rest').value) || 5));
            localStorage.setItem('eduplan_work_time', workTimerMinutes);
            localStorage.setItem('eduplan_rest_time', restTimerMinutes);
        }

        function exportData() {
            const backup = { schedule, tasks, history, version: '2.0', exportedAt: new Date().toISOString() };
            const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `eduplan_backup_${new Date().toISOString().slice(0, 10)}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function importData(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.schedule) { schedule = data.schedule; localStorage.setItem('eduplan_schedule', JSON.stringify(schedule)); }
                    if (Array.isArray(data.tasks)) { tasks = data.tasks; localStorage.setItem('eduplan_tasks', JSON.stringify(tasks)); }
                    if (Array.isArray(data.history)) { history = data.history; localStorage.setItem('eduplan_history', JSON.stringify(history)); }
                    alert('Данные успешно импортированы!');
                    location.reload();
                } catch (err) { alert('Ошибка в формате файла JSON'); }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        function wipeAllData() {
            if (confirm('Стереть все расписания, задания и историю?')) {
                localStorage.clear();
                location.reload();
            }
        }

        function loadScheduleForDay() {
            const day = document.getElementById('schedule-day').value;
            document.getElementById('schedule-subjects').value = (schedule[day] || []).join(', ');
        }
        function saveSchedule() {
            const day = document.getElementById('schedule-day').value;
            const subjects = document.getElementById('schedule-subjects').value.split(',').map(s => s.trim()).filter(s => s.length > 0);
            schedule[day] = subjects;
            localStorage.setItem('eduplan_schedule', JSON.stringify(schedule));
            const status = document.getElementById('schedule-status');
            status.style.display = 'block'; setTimeout(() => status.style.display = 'none', 2500);
            renderDashboard();
        }

        function loadSubjectsForHomework() {
            const day = document.getElementById('hw-day').value;
            const select = document.getElementById('hw-subject');
            select.innerHTML = '';
            if (!schedule[day] || schedule[day].length === 0) {
                select.innerHTML = '<option disabled selected>Нет предметов в расписании</option>';
                return;
            }
            schedule[day].forEach(s => {
                const opt = document.createElement('option');
                opt.value = s; opt.textContent = s;
                select.appendChild(opt);
            });
        }

        function addTask() {
            const day = document.getElementById('hw-day').value;
            const subject = document.getElementById('hw-subject').value;
            const desc = document.getElementById('hw-desc').value.trim();
            const difficulty = parseInt(document.getElementById('hw-difficulty').value);
            const priority = document.getElementById('hw-priority').value;
            const dueDate = document.getElementById('hw-due').value;
            if (!subject) return;

            const dayNames = {1:'Пн', 2:'Вт', 3:'Ср', 4:'Чт', 5:'Пт', 6:'Сб'};
            tasks.push({
                id: Date.now(),
                day: Number(day),
                dayName: dayNames[day] || 'Пн',
                subject,
                desc: desc || 'Задание',
                difficulty,
                priority,
                dueDate: dueDate || null
            });
            localStorage.setItem('eduplan_tasks', JSON.stringify(tasks));
            document.getElementById('hw-desc').value = '';
            document.getElementById('hw-due').value = '';
            const status = document.getElementById('hw-status');
            status.style.display = 'block'; setTimeout(() => status.style.display = 'none', 2500);
            renderTasks();
            renderDashboard();
        }

        function openEditTask(id) {
            const task = tasks.find(t => t.id === id);
            if (!task) return;
            document.getElementById('edit-task-id').value = task.id;
            document.getElementById('edit-task-subject').value = task.subject;
            document.getElementById('edit-task-desc').value = task.desc;
            document.getElementById('edit-task-due').value = task.dueDate || '';
            document.getElementById('edit-task-priority').value = task.priority;
            document.getElementById('edit-task-difficulty').value = task.difficulty;
            document.getElementById('edit-task-modal').style.display = 'flex';
        }
        function closeEditTask() { document.getElementById('edit-task-modal').style.display = 'none'; }
        function saveEditedTask() {
            const id = parseInt(document.getElementById('edit-task-id').value);
            const task = tasks.find(t => t.id === id);
            if (!task) return;
            const sub = document.getElementById('edit-task-subject').value.trim();
            if (!sub) return;
            task.subject = sub;
            task.desc = document.getElementById('edit-task-desc').value.trim() || 'Задание';
            task.dueDate = document.getElementById('edit-task-due').value || null;
            task.priority = document.getElementById('edit-task-priority').value;
            task.difficulty = parseInt(document.getElementById('edit-task-difficulty').value);
            localStorage.setItem('eduplan_tasks', JSON.stringify(tasks));
            closeEditTask();
            renderTasks();
            renderDashboard();
        }

        function getTimeEstimate(diff) { return diff === 3 ? 45 : diff === 2 ? 30 : 15; }
        function priorityWeight(p) { return ({urgent:4, important:3, normal:2, low:1}[p] || 2); }
        function todayString() { return new Date().toISOString().slice(0,10); }
        function isOverdue(task) { return !!task.dueDate && task.dueDate < todayString(); }
        function isToday(task) { return !!task.dueDate && task.dueDate === todayString(); }

        function renderTasks() {
            const container = document.getElementById('tasks-container');
            container.innerHTML = '';
            if (!tasks.length) {
                container.innerHTML = '<div style="text-align:center;padding:2.5rem 1rem;color:var(--text-muted);font-size:0.9rem;">Все задачи выполнены! Отдыхайте 🎉</div>';
                return;
            }
            const search = (document.getElementById('task-search')?.value || '').toLowerCase().trim();
            const filter = document.getElementById('task-filter')?.value || 'all';
            const sort = document.getElementById('task-sort')?.value || 'smart';

            let filtered = tasks.filter(t => {
                if (search && !(`${t.subject} ${t.desc}`.toLowerCase().includes(search))) return false;
                if (filter === 'urgent' && t.priority !== 'urgent') return false;
                if (filter === 'overdue' && !isOverdue(t)) return false;
                if (filter === 'today' && !isToday(t)) return false;
                return true;
            });

            const deadlineValue = t => t.dueDate ? new Date(t.dueDate + 'T00:00:00').getTime() : Number.MAX_SAFE_INTEGER;
            filtered.sort((a,b) => {
                if (sort === 'deadline') return deadlineValue(a) - deadlineValue(b);
                if (sort === 'priority') return priorityWeight(b.priority) - priorityWeight(a.priority);
                if (sort === 'difficulty') return b.difficulty - a.difficulty;
                return (isOverdue(b) - isOverdue(a)) || (deadlineValue(a) - deadlineValue(b)) || (priorityWeight(b.priority) - priorityWeight(a.priority));
            });

            filtered.forEach(task => {
                const diffText = task.difficulty === 3 ? 'Сложная' : task.difficulty === 2 ? 'Средняя' : 'Лёгкая';
                const prioText = ({urgent:'Срочно', important:'Важно', normal:'Обычное', low:'Позже'})[task.priority] || 'Обычное';
                const overdueCls = isOverdue(task) ? 'overdue' : '';
                container.innerHTML += `
                    <div class="task-card diff-${task.difficulty} ${overdueCls}">
                        <div class="task-title">${task.subject}</div>
                        <div class="task-desc">${task.desc}</div>
                        <div class="task-meta">
                            <span class="badge">${task.dayName}</span>
                            <span class="badge">${diffText}</span>
                            <span class="badge priority-${task.priority}">${prioText}</span>
                            <span class="badge">~${getTimeEstimate(task.difficulty)} мин</span>
                        </div>
                        <div class="task-actions">
                            <button class="btn-start" onclick="openTimer(${task.id})">▶ Запустить</button>
                            <button class="btn-card-action edit" onclick="openEditTask(${task.id})">✏️</button>
                            <button class="btn-card-action delete" onclick="deleteTask(${task.id})">🗑️</button>
                        </div>
                    </div>`;
            });
        }

        function deleteTask(id) {
            if (confirm('Удалить эту задачу?')) {
                tasks = tasks.filter(t => t.id !== id);
                localStorage.setItem('eduplan_tasks', JSON.stringify(tasks));
                renderTasks();
                renderDashboard();
            }
        }

        function selectDayPill(dayNum, btn) {
            selectedDayPill = dayNum;
            document.querySelectorAll('.day-pill').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            renderDayTasks();
        }

        function renderDayTasks() {
            const container = document.getElementById('day-tasks-container');
            const dayTasks = tasks.filter(t => Number(t.day) === selectedDayPill);
            const subjects = schedule[selectedDayPill] || [];

            let html = '';
            if (subjects.length > 0) {
                html += `<div style="font-size:0.75rem; color:var(--text-muted); margin-bottom:0.5rem;">По расписанию: ${subjects.join(', ')}</div>`;
            }
            if (!dayTasks.length) {
                html += `<div style="color:var(--text-muted); font-size:0.85rem; padding:0.6rem 0;">Нет домашних заданий на этот день</div>`;
            } else {
                html += dayTasks.map(t => `
                    <div class="calendar-task-item" onclick="switchTab('tab-tasks')">
                        <div><strong>${t.subject}</strong> <span style="color:var(--text-muted);">· ${t.desc}</span></div>
                        <span style="font-weight:700; color:var(--primary); font-size:0.8rem;">~${getTimeEstimate(t.difficulty)} м</span>
                    </div>
                `).join('');
            }
            container.innerHTML = html;
        }

        function renderDashboard() {
            const totalMinutes = tasks.reduce((sum, t) => sum + getTimeEstimate(t.difficulty), 0);
            const done = history.length;
            const all = done + tasks.length;
            const progress = all ? Math.round(done / all * 100) : 0;
            const overdue = tasks.filter(isOverdue).length;

            document.getElementById('stat-tasks').textContent = tasks.length;
            document.getElementById('stat-overdue').textContent = overdue;
            document.getElementById('stat-time').textContent = `${totalMinutes} м`;
            document.getElementById('stat-done').textContent = done;
            document.getElementById('stat-progress').textContent = `${progress}%`;
            document.getElementById('progress-fill').style.width = `${progress}%`;

            renderDayTasks();

            const workloadBox = document.getElementById('workload-grid');
            if (workloadBox) {
                const map = {};
                tasks.forEach(t => { map[t.subject] = (map[t.subject] || 0) + getTimeEstimate(t.difficulty); });
                const entries = Object.entries(map).sort((a, b) => b[1] - a[1]);
                if (!entries.length) {
                    workloadBox.innerHTML = '<div style="color:var(--text-muted);font-size:0.8rem;padding:0.4rem 0;">Все уроки сделаны</div>';
                } else {
                    const max = Math.max(...entries.map(e => e[1])) || 1;
                    workloadBox.innerHTML = entries.map(([sub, m]) => `
                        <div class="workload-row">
                            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;">${sub}</span>
                            <div class="workload-bar"><span style="width:${Math.round(m/max*100)}%"></span></div>
                            <span style="text-align:right;color:var(--text-muted);">${m} м</span>
                        </div>
                    `).join('');
                }
            }

            const achieveBox = document.getElementById('achievement-grid');
            if (achieveBox) {
                const filledDays = Object.values(schedule).filter(s => Array.isArray(s) && s.length > 0).length;
                const list = [
                    { title: 'Первый шаг', desc: '1 задача', unlocked: history.length >= 1 },
                    { title: 'В ритме', desc: '5 задач', unlocked: history.length >= 5 },
                    { title: 'Стратег', desc: '3+ дня в сетке', unlocked: filledDays >= 3 },
                    { title: 'Без долгов', desc: 'Нет просрочек', unlocked: tasks.length > 0 && overdue === 0 }
                ];
                achieveBox.innerHTML = list.map(a => `
                    <div class="achievement ${a.unlocked ? 'unlocked' : ''}">
                        <strong>${a.unlocked ? '🏆 ' : '🔒 '}${a.title}</strong>
                        <small style="color:var(--text-muted);">${a.desc}</small>
                    </div>
                `).join('');
            }
        }

        function renderHistory() {
            const box = document.getElementById('history-container');
            if (!history.length) {
                box.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-size:0.85rem;">История пока пуста</div>';
                return;
            }
            box.innerHTML = history.map(item => `
                <div class="history-item">
                    <div><strong>${item.subject}</strong><div style="color:var(--text-muted);font-size:0.75rem;">${item.desc} · ${item.completedAt}</div></div>
                    <span style="color:var(--success);font-weight:bold;font-size:0.8rem;">✓ готово</span>
                </div>
            `).join('');
        }

        function clearHistory() {
            if (confirm('Очистить историю выполненных заданий?')) {
                history = [];
                localStorage.setItem('eduplan_history', JSON.stringify(history));
                renderHistory();
                renderDashboard();
            }
        }

        function openTimer(taskId) {
            currentTimerTask = tasks.find(t => t.id === taskId);
            if (!currentTimerTask) return;
            const overlay = document.getElementById('timer-overlay');
            overlay.style.display = 'flex';

            document.getElementById('timer-subject').textContent = currentTimerTask.subject;
            document.getElementById('timer-desc').textContent = currentTimerTask.desc;

            const workMins = workTimerMinutes || getTimeEstimate(currentTimerTask.difficulty);
            timeRemaining = workMins * 60;
            isRestPhase = false;
            isPaused = false;

            document.getElementById('timer-phase').textContent = 'ФОКУС';
            document.getElementById('timer-phase').style.color = 'var(--primary)';
            document.getElementById('btn-timer-pause').textContent = '⏸ Пауза';
            document.getElementById('timer-circle-elem').classList.remove('paused');

            timerTargetTimestamp = Date.now() + timeRemaining * 1000;
            updateTimerDisplay();
            startTimerLoop();
        }

        function closeTimer() {
            clearInterval(timerInterval);
            document.getElementById('timer-overlay').style.display = 'none';
            currentTimerTask = null;
        }

        function updateTimerDisplay() {
            const m = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
            const s = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').textContent = `${m}:${s}`;
        }

        function startTimerLoop() {
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (!isPaused) {
                    const now = Date.now();
                    timeRemaining = Math.max(0, Math.round((timerTargetTimestamp - now) / 1000));
                    updateTimerDisplay();
                    if (timeRemaining <= 0) handleTimerCompletion();
                }
            }, 1000);
        }

        function handleTimerCompletion() {
            clearInterval(timerInterval);
            playAlertSound();
            if (!isRestPhase) {
                isRestPhase = true;
                timeRemaining = restTimerMinutes * 60;
                timerTargetTimestamp = Date.now() + timeRemaining * 1000;
                document.getElementById('timer-phase').textContent = 'ОТДЫХ';
                document.getElementById('timer-phase').style.color = 'var(--success)';
                alert('Время работы вышло! Время отдохнуть.');
                startTimerLoop();
            } else {
                alert('Цикл завершен! Отличная работа.');
                finishTask(true);
            }
        }

        function toggleTimer() {
            isPaused = !isPaused;
            const btn = document.getElementById('btn-timer-pause');
            const circle = document.getElementById('timer-circle-elem');
            if (isPaused) {
                btn.textContent = '▶ Продолжить';
                circle.classList.add('paused');
            } else {
                btn.textContent = '⏸ Пауза';
                circle.classList.remove('paused');
                timerTargetTimestamp = Date.now() + timeRemaining * 1000;
            }
        }

        function finishTask(completed) {
            clearInterval(timerInterval);
            document.getElementById('timer-overlay').style.display = 'none';
            if (!currentTimerTask) return;
            const task = currentTimerTask;
            tasks = tasks.filter(t => t.id !== task.id);
            localStorage.setItem('eduplan_tasks', JSON.stringify(tasks));
            if (completed) {
                history.unshift({
                    subject: task.subject,
                    desc: task.desc,
                    completedAt: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })
                });
                localStorage.setItem('eduplan_history', JSON.stringify(history));
            }
            currentTimerTask = null;
            renderTasks();
            renderDashboard();
            renderHistory();
        }

        const todayDayOfWeek = new Date().getDay();
        selectedDayPill = (todayDayOfWeek >= 1 && todayDayOfWeek <= 6) ? todayDayOfWeek : 1;
        const pillBtn = document.querySelectorAll('.day-pill')[selectedDayPill - 1];
        if (pillBtn) selectDayPill(selectedDayPill, pillBtn);

        loadScheduleForDay();
        renderDashboard();
    </script>
</body>
</html>
