<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>EduPlan — Учебный органайзер</title>

    <!-- PWA & iOS мета-теги -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="EduPlan">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#050b14">
    <meta name="format-detection" content="telephone=no">

    <!-- Иконка приложения (SVG Data URI) -->
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect width='180' height='180' rx='40' fill='%230f172a'/><path d='M90 35 L145 90 L90 145 L35 90 Z' fill='none' stroke='%2338bdf8' stroke-width='14'/><circle cx='90' cy='90' r='22' fill='%233b82f6'/></svg>">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>❖</text></svg>">

    <!-- Встроенный Web App Manifest -->
    <link rel="manifest" href="data:application/manifest+json,%7B%22name%22%3A%22EduPlan%22%2C%22short_name%22%3A%22EduPlan%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23050b14%22%2C%22theme_color%22%3A%22%23050b14%22%2C%22orientation%22%3A%22portrait%22%7D">

    <style>
        :root {
            --bg-color: #050b14;
            --surface-color: rgba(15, 23, 42, 0.88);
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #3b82f6;
            --secondary: #0ea5e9;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --border: rgba(255, 255, 255, 0.08);
            --shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            --glass-blur: blur(20px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-top: env(safe-area-inset-top, 0px);
        }

        [data-theme="light"] { --bg-color: #f1f5f9; --surface-color: rgba(255, 255, 255, 0.9); --text-color: #0f172a; --text-muted: #64748b; --primary: #2563eb; --secondary: #0284c7; --border: rgba(0, 0, 0, 0.08); --shadow: 0 8px 24px rgba(0, 0, 0, 0.06); }
        [data-theme="purple"] { --bg-color: #0f0a1f; --surface-color: rgba(30, 20, 50, 0.88); --text-color: #f8fafc; --text-muted: #a78bfa; --primary: #8b5cf6; --secondary: #d946ef; --border: rgba(255, 255, 255, 0.08); --shadow: 0 8px 24px rgba(0, 0, 0, 0.4); }
        [data-theme="blue"] { --bg-color: #081229; --surface-color: rgba(15, 30, 60, 0.88); --text-color: #f8fafc; --text-muted: #93c5fd; --primary: #2563eb; --secondary: #38bdf8; --border: rgba(255, 255, 255, 0.08); --shadow: 0 8px 24px rgba(0, 0, 0, 0.4); }
        [data-theme="emerald"] { --bg-color: #022c22; --surface-color: rgba(6, 78, 59, 0.88); --text-color: #ecfdf5; --text-muted: #6ee7b7; --primary: #10b981; --secondary: #34d399; --border: rgba(255, 255, 255, 0.08); --shadow: 0 8px 24px rgba(0, 0, 0, 0.4); }
        [data-theme="sunset"] { --bg-color: #2e0e0a; --surface-color: rgba(50, 15, 10, 0.88); --text-color: #fff7ed; --text-muted: #fdba74; --primary: #f97316; --secondary: #f43f5e; --border: rgba(255, 255, 255, 0.08); --shadow: 0 8px 24px rgba(0, 0, 0, 0.4); }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }
        
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            padding-top: calc(var(--safe-top) + 60px);
            padding-bottom: calc(var(--safe-bottom) + 76px);
            user-select: none;
            -webkit-user-select: none;
        }

        .bg-shape { position: fixed; border-radius: 50%; filter: blur(70px); z-index: -1; opacity: 0.35; pointer-events: none; }
        .shape-1 { width: 320px; height: 320px; background: var(--primary); top: -80px; left: -80px; }
        .shape-2 { width: 340px; height: 340px; background: var(--secondary); bottom: 20px; right: -90px; }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: calc(var(--safe-top) + 54px);
            padding: var(--safe-top) 16px 0 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--surface-color);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border-bottom: 1px solid var(--border);
            z-index: 100;
        }
        h1 { font-size: 1.35rem; font-weight: 800; display: flex; align-items: center; gap: 8px; }
        .logo-icon { background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .header-btn {
            background: transparent;
            border: none;
            color: var(--text-color);
            font-size: 1.3rem;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .header-btn:active { transform: scale(0.9); }

        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: calc(var(--safe-bottom) + 64px);
            padding-bottom: var(--safe-bottom);
            background: var(--surface-color);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border-top: 1px solid var(--border);
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            z-index: 100;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 0.7rem;
            font-weight: 600;
            gap: 4px;
            cursor: pointer;
            transition: color 0.15s, transform 0.1s;
        }
        .nav-item .icon { font-size: 1.25rem; line-height: 1; }
        .nav-item.active { color: var(--primary); }
        .nav-item:active { transform: scale(0.92); }

        main { padding: 14px 14px 20px 14px; width: 100%; flex-grow: 1; max-width: 480px; margin: 0 auto; }
        .tab-content { display: none; animation: fadeIn 0.25s ease-out; }
        .tab-content.active { display: block; }

        .glass-panel {
            background: var(--surface-color);
            border-radius: 18px;
            padding: 1.2rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            margin-bottom: 1.2rem;
        }
        h2 { font-size: 1.3rem; margin-bottom: 1rem; color: var(--primary); font-weight: 700; }
        h3 { font-size: 1rem; font-weight: 700; color: var(--text-color); margin-bottom: 0.6rem; }

        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.35rem; font-weight: 600; font-size: 0.85rem; color: var(--text-muted); }
        
        input, select, button, textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-color);
            font-size: 16px;
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }
        [data-theme="light"] input, [data-theme="light"] select { background: #fff; border-color: rgba(0,0,0,0.12); }
        input:focus, select:focus { border-color: var(--primary); }
        select option { background-color: var(--bg-color); color: var(--text-color); }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #fff;
            border: none;
            font-weight: 700;
            padding: 0.85rem 1rem;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 15px -4px var(--primary);
            margin-top: 0.8rem;
            font-size: 1rem;
            min-height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.1s, opacity 0.1s;
        }
        .btn-primary:active { transform: scale(0.98); opacity: 0.9; }

        .btn-secondary {
            background: rgba(255,255,255,0.06);
            color: var(--text-color);
            border: 1px solid var(--border);
            font-weight: 600;
            padding: 0.65rem 1rem;
            border-radius: 10px;
            font-size: 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
        }
        .btn-secondary:active { background: rgba(255,255,255,0.12); }

        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
            border: 1px solid var(--danger);
            font-weight: 700;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.95rem;
            min-height: 44px;
            cursor: pointer;
        }
        .btn-danger:active { background: var(--danger); color: white; }

        .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; margin-bottom: 1.2rem; }
        .stat-card { padding: 0.9rem; border-radius: 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); }
        .stat-card.full-width { grid-column: span 2; }
        .stat-label { color: var(--text-muted); font-size: 0.75rem; margin-bottom: 0.25rem; }
        .stat-value { font-size: 1.4rem; font-weight: 800; }
        .progress-bar { height: 7px; border-radius: 99px; overflow: hidden; background: rgba(100,116,139,0.25); margin-top: 0.5rem; }
        .progress-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--primary), var(--secondary)); transition: width 0.4s ease; }

        .day-pills-wrap { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 0.8rem; -webkit-overflow-scrolling: touch; }
        .day-pill {
            flex: 0 0 auto;
            padding: 0.45rem 0.85rem;
            border-radius: 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }
        .day-pill.active { background: var(--primary); color: #fff; border-color: var(--primary); }
        .day-tasks-box { min-height: 80px; }
        .calendar-task-item {
            padding: 0.65rem 0.8rem;
            border-radius: 10px;
            background: rgba(59, 130, 246, 0.08);
            border: 1px solid var(--border);
            margin-bottom: 0.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
        }

        .workload-row { display: grid; grid-template-columns: 95px 1fr 55px; gap: 0.5rem; align-items: center; margin: 0.5rem 0; font-size: 0.8rem; }
        .workload-bar { height: 6px; border-radius: 99px; background: rgba(100,116,139,0.2); overflow: hidden; }
        .workload-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--primary), var(--secondary)); }

        .achievement-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
        .achievement { padding: 0.75rem; border: 1px solid var(--border); border-radius: 12px; opacity: 0.4; background: rgba(255,255,255,0.02); font-size: 0.8rem; }
        .achievement.unlocked { opacity: 1; border-color: var(--success); background: rgba(16,185,129,0.08); }
        .achievement strong { display: block; margin-bottom: 0.15rem; font-size: 0.82rem; }

        .task-toolbar { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
        .task-filters-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
        .task-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-left: 4px solid var(--primary);
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 0.8rem;
        }
        [data-theme="light"] .task-card { background: #fff; }
        .task-card.diff-3 { border-left-color: var(--danger); }
        .task-card.diff-2 { border-left-color: var(--warning); }
        .task-card.diff-1 { border-left-color: var(--success); }
        .task-title { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.25rem; }
        .task-desc { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.7rem; }
        .task-meta { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
        .badge { background: rgba(150, 150, 150, 0.12); padding: 0.2rem 0.5rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; }
        .task-actions { display: flex; gap: 0.5rem; }
        .btn-start {
            flex: 2;
            background: transparent;
            border: 1.5px solid var(--primary);
            color: var(--primary);
            font-weight: 700;
            padding: 0.6rem;
            border-radius: 10px;
            cursor: pointer;
            font-size: 0.85rem;
            min-height: 42px;
        }
        .btn-start:active { background: var(--primary); color: #fff; }
        .btn-card-action {
            flex: 1;
            padding: 0.6rem;
            border-radius: 10px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 1px solid var(--border);
            min-height: 42px;
        }
        .btn-card-action.edit { background: rgba(59, 130, 246, 0.1); color: var(--primary); }
        .btn-card-action.delete { background: rgba(239, 68, 68, 0.1); color: var(--danger); border-color: rgba(239, 68, 68, 0.2); }

        .priority-urgent { color: var(--danger); font-weight: bold; }
        .priority-important { color: var(--warning); font-weight: bold; }
        .priority-normal { color: var(--primary); }
        .priority-low { color: var(--text-muted); }
        .overdue { border-color: var(--danger) !important; }
        .due-overdue { color: var(--danger); font-weight: 700; }
        .due-today { color: var(--warning); font-weight: 700; }

        .history-list { display: grid; gap: 0.6rem; }
        .history-item { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem; border: 1px solid var(--border); border-radius: 12px; background: rgba(255,255,255,0.02); font-size: 0.85rem; }

        .timer-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--bg-color);
            z-index: 500;
            justify-content: center;
            align-items: center;
            padding: calc(var(--safe-top) + 20px) 20px calc(var(--safe-bottom) + 20px) 20px;
            animation: fadeIn 0.25s ease;
        }
        .timer-panel {
            width: 100%;
            max-width: 360px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }
        .timer-btn-close {
            position: absolute;
            top: -10px;
            right: 0;
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--border);
            color: var(--text-muted);
            width: 38px;
            height: 38px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #timer-subject { font-size: 1.4rem; font-weight: 800; text-align: center; margin-bottom: 0.2rem; }
        #timer-desc { color: var(--text-muted); font-size: 0.9rem; text-align: center; margin-bottom: 1.5rem; }
        
        .timer-circle {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            border: 6px solid rgba(150,150,150,0.12);
            border-top-color: var(--primary);
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            margin-bottom: 2rem;
            position: relative;
            animation: spin 10s linear infinite;
        }
        .timer-circle-inner {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: spin 10s linear infinite reverse;
        }
        .timer-circle.paused, .timer-circle.paused .timer-circle-inner {
            animation-play-state: paused !important;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        
        .timer-time { font-size: 3.2rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
        .timer-phase { font-size: 0.8rem; color: var(--primary); font-weight: 700; margin-top: 6px; letter-spacing: 1.5px; text-transform: uppercase; }
        .timer-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; width: 100%; }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 600;
            justify-content: center;
            align-items: flex-end;
            padding: 0;
        }
        .modal-card {
            background: var(--surface-color);
            border: 1px solid var(--border);
            border-radius: 24px 24px 0 0;
            width: 100%;
            max-width: 500px;
            padding: 1.4rem 1.2rem calc(var(--safe-bottom) + 1.2rem) 1.2rem;
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            max-height: 88vh;
            overflow-y: auto;
        }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; }
        .modal-handle { width: 36px; height: 5px; background: rgba(150,150,150,0.3); border-radius: 3px; margin: -6px auto 12px auto; }
        .btn-close { background: transparent; border: none; font-size: 1.4rem; color: var(--text-muted); padding: 0.3rem; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
    </style>
</head>
<body data-theme="dark">

    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>

    <header>
        <h1><span class="logo-icon">❖</span> EduPlan</h1>
        <button class="header-btn" onclick="openSettings()" title="Настройки">⚙️</button>
    </header>

    <main>
        <!-- Вкладка 1: Обзор -->
        <section id="tab-dashboard" class="tab-content">
            <div class="glass-panel">
                <h2>Обзор и статистика</h2>
                <div class="dashboard-grid">
                    <div class="stat-card"><div class="stat-label">Всего задач</div><div class="stat-value" id="stat-tasks">0</div></div>
                    <div class="stat-card"><div class="stat-label">Просрочено</div><div class="stat-value" id="stat-overdue" style="color:var(--danger)">0</div></div>
                    <div class="stat-card"><div class="stat-label">Время на работу</div><div class="stat-value" id="stat-time">0 м</div></div>
                    <div class="stat-card"><div class="stat-label">Выполнено</div><div class="stat-value" id="stat-done">0</div></div>
                    <div class="stat-card full-width">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span class="stat-label">Прогресс выполнения</span>
                            <span id="stat-progress" style="font-weight:700; font-size:0.9rem;">0%</span>
                        </div>
                        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
                    </div>
                </div>

                <h3>Расписание на неделю</h3>
                <div class="day-pills-wrap" id="day-pills">
                    <button class="day-pill active" onclick="selectDayPill(1, this)">Пн</button>
                    <button class="day-pill" onclick="selectDayPill(2, this)">Вт</button>
                    <button class="day-pill" onclick="selectDayPill(3, this)">Ср</button>
                    <button class="day-pill" onclick="selectDayPill(4, this)">Чт</button>
                    <button class="day-pill" onclick="selectDayPill(5, this)">Пт</button>
                    <button class="day-pill" onclick="selectDayPill(6, this)">Сб</button>
                </div>
                <div id="day-tasks-container" class="day-tasks-box"></div>

                <div style="margin-top: 1.2rem;">
                    <h3>Учебная нагрузка</h3>
                    <div id="workload-grid"></div>
                </div>

                <div style="margin-top: 1.2rem;">
                    <h3>Достижения</h3>
                    <div id="achievement-grid" class="achievement-grid"></div>
                </div>
            </div>
        </section>

        <!-- Вкладка 2: Расписание -->
        <section id="tab-schedule" class="tab-content">
            <div class="glass-panel">
                <h2>Настройка расписания</h2>
                <div class="form-group">
                    <label>Выберите день недели:</label>
                    <select id="schedule-day" onchange="loadScheduleForDay()">
                        <option value="1">Понедельник</option><option value="2">Вторник</option><option value="3">Среда</option>
                        <option value="4">Четверг</option><option value="5">Пятница</option><option value="6">Суббота</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Предметы (через запятую):</label>
                    <input type="text" id="schedule-subjects" placeholder="Алгебра, Физика, Русский язык">
                </div>
                <button class="btn-primary" onclick="saveSchedule()">Сохранить на этот день</button>
                <div id="schedule-status" style="margin-top: 0.8rem; color: var(--success); font-weight: bold; display: none; text-align: center;">Сохранено!</div>
            </div>
        </section>

        <!-- Вкладка 3: Добавить -->
        <section id="tab-homework" class="tab-content">
            <div class="glass-panel">
                <h2>Новое задание</h2>
                <div class="form-group">
                    <label>Учебный день:</label>
                    <select id="hw-day" onchange="loadSubjectsForHomework()">
                        <option value="" disabled selected>Выберите день недели...</option>
                        <option value="1">Понедельник</option><option value="2">Вторник</option><option value="3">Среда</option>
                        <option value="4">Четверг</option><option value="5">Пятница</option><option value="6">Суббота</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Предмет:</label>
                    <select id="hw-subject"><option value="" disabled selected>Сначала выберите день выше</option></select>
                </div>
                <div class="form-group">
                    <label>Содержание задания:</label>
                    <input type="text" id="hw-desc" placeholder="Параграф 12, номера 3-5">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Срок сдачи:</label>
                        <input type="date" id="hw-due">
                    </div>
                    <div class="form-group">
                        <label>Срочность:</label>
                        <select id="hw-priority">
                            <option value="urgent">Срочно</option>
                            <option value="important">Важно</option>
                            <option value="normal" selected>Обычное</option>
                            <option value="low">Позже</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Сложность / Время:</label>
                    <select id="hw-difficulty">
                        <option value="1">Низкая — ~15 мин</option>
                        <option value="2" selected>Средняя — ~30 мин</option>
                        <option value="3">Высокая — ~45 мин</option>
                    </select>
                </div>
                <button class="btn-primary" onclick="addTask()">Добавить в план</button>
                <div id="hw-status" style="margin-top: 0.8rem; color: var(--success); font-weight: bold; display: none; text-align: center;">Успешно добавлено!</div>
            </div>
        </section>

        <!-- Вкладка 4: Выполнение -->
        <section id="tab-tasks" class="tab-content">
            <div class="glass-panel">
                <h2>План работы</h2>
                <div class="task-toolbar">
                    <input id="task-search" type="search" placeholder="Поиск по задачам..." oninput="renderTasks()">
                    <div class="task-filters-row">
                        <select id="task-filter" onchange="renderTasks()">
                            <option value="all">Все задачи</option>
                            <option value="urgent">Срочные</option>
                            <option value="overdue">Просроченные</option>
                            <option value="today">На сегодня</option>
                        </select>
                        <select id="task-sort" onchange="renderTasks()">
                            <option value="smart">Умная</option>
                            <option value="deadline">По сроку</option>
                            <option value="priority">По важности</option>
                            <option value="difficulty">Сложность</option>
                        </select>
                    </div>
                </div>
                <div id="tasks-container"></div>
            </div>
