        <!-- Вкладка 5: История -->
        <section id="tab-history" class="tab-content">
            <div class="glass-panel">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                    <h2 style="margin:0;">История</h2>
                    <button class="btn-secondary" style="min-height:36px; padding:0.4rem 0.8rem; font-size:0.8rem;" onclick="clearHistory()">Очистить</button>
                </div>
                <div id="history-container" class="history-list"></div>
            </div>
        </section>
    </main>

    <!-- Нижний таббар iOS -->
    <nav class="bottom-nav">
        <button class="nav-item active" data-tab="tab-dashboard" onclick="switchTab('tab-dashboard', this)">
            <span class="icon">📊</span><span>Обзор</span>
