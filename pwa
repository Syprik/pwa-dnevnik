    <!-- Модалка Редактирования -->
    <div id="edit-task-modal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-handle"></div>
            <div class="modal-header">
                <h3>Редактировать задачу</h3>
                <button class="btn-close" onclick="closeEditTask()">&times;</button>
            </div>
            <input type="hidden" id="edit-task-id">
            <div class="form-group"><label>Предмет:</label><input type="text" id="edit-task-subject"></div>
            <div class="form-group"><label>Задание:</label><input type="text" id="edit-task-desc"></div>
            <div class="form-row">
                <div class="form-group"><label>Срок:</label><input type="date" id="edit-task-due"></div>
                <div class="form-group">
                    <label>Срочность:</label>
                    <select id="edit-task-priority">
                        <option value="urgent">Срочно</option><option value="important">Важно</option>
                        <option value="normal">Обычное</option><option value="low">Позже</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Сложность:</label>
                <select id="edit-task-difficulty">
                    <option value="1">Низкая (~15 мин)</option>
